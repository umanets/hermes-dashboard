# Copy to .env (or add these to ~/.hermes/.env). NEVER commit real values.

# --- Apple Music ------------------------------------------------------------
# Requires an Apple Developer Program membership to generate the MusicKit key.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Absolute path to your MusicKit private key (.p8). Do NOT paste the key here.
APPLE_PRIVATE_KEY_PATH=
# Storefront for catalog/search calls (us, gb, ua, ...).
APPLE_MUSIC_STOREFRONT=us
# Optional: set after running `python -m music_service.cli auth apple`.
# If left blank, the token store at ~/.hermes/music_tools/apple_tokens.json is used.
APPLE_MUSIC_USER_TOKEN=

# --- TIDAL (official developer API v2) -------------------------------------
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
# Must EXACTLY match a redirect URI registered for your TIDAL app.
TIDAL_REDIRECT_URI=http://127.0.0.1:8765/callback
# Two-letter country code used for catalog/search calls.
TIDAL_COUNTRY=US
# Optional: override requested OAuth scopes (space-separated). Default includes
# read + write; write tools only work if your app was granted playlists.write.
# TIDAL_SCOPES=user.read collection.read playlists.read search.read collection.write playlists.write
