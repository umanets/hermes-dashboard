# Hermes dashboard configuration. Copy to `.env` (same dir you run `npm start` from — the repo root)
# and fill in. Loaded automatically on Node >= 20.6; otherwise export these in your shell.
# NEVER commit the real .env (it's gitignored).

# --- core ---
# Where per-client Hermes volumes, the registry, and the Hindsight pg0 data live.
# Default: ~/hermes-clients
CLIENTS_ROOT=/home/you/hermes-clients

# API/UI port (the API also serves the built web UI). Default: 4000
# PORT=4000

# --- Docker / fleet ---
# On LINUX, set these to your own uid/gid so files the container writes in the
# bind-mounted volume stay editable by the dashboard (run `id -u` / `id -g`).
HERMES_UID=1000
HERMES_GID=1000

# Base Hermes image tag (built by the dashboard's "Build image"). Default: hermes-agent
# HERMES_IMAGE=hermes-agent
# Source repo cloned to build the image (needs SSH access; private).
# HERMES_AGENT_REPO_URL=git@github.com:your-org/hermes-agent.git
# HERMES_SRC_DIR=/home/you/hermes-agent-src
# Docker network linking the fleet to the shared Hindsight memory service. Default: hermes-net
# HERMES_NET=hermes-net

# --- Hindsight memory (shared service) ---
# Required to start the Memory service. Used by Hindsight for retain/reflect LLM calls.
OPENROUTER_API_KEY=
# LLM model for Hindsight (retain is LLM-heavy → pick a cheap one). Default: openai/gpt-4o-mini
# HINDSIGHT_LLM_MODEL=openai/gpt-4o-mini
# HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:latest
